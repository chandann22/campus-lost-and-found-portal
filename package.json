{
  "name": "campus-lost-found-portal",
  "version": "1.0.0",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:client": "npm --prefix client install"
  },
  "dependencies": {
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jsonwebtoken": "latest",
    "mongoose": "latest",
    "socket.io": "latest",
    "socket.io-client": "latest",
    "uuid": "latest"
  },
  "devDependencies": {
    "nodemon": "latest"
  }
}
